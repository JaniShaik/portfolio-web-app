# Copy to `.env.local` for local development. Never commit real values.

# Public, canonical site URL (used for SEO metadata, sitemap and robots).
# Falls back to the Vercel production URL, then http://localhost:3000.
NEXT_PUBLIC_SITE_URL=

# Resend API key (server-only). Optional: the contact API returns 503 when unset.
RESEND_API_KEY=

# Inbox that receives contact form submissions (server-only). Optional.
CONTACT_EMAIL=

# Upstash Redis for distributed rate limiting of the contact API (server-only).
# Required in production whenever email is configured: the endpoint fails closed
# (503) without it. The Vercel Marketplace integration's KV_REST_API_URL /
# KV_REST_API_TOKEN names are also accepted.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Optional rate-limit thresholds (defaults shown).
# CONTACT_RATE_LIMIT_MAX=5
# CONTACT_RATE_LIMIT_WINDOW_SECONDS=3600
# CONTACT_RATE_LIMIT_DAILY_MAX=100

# Self-hosting only: trust x-real-ip / x-forwarded-for from your reverse proxy.
# Leave unset on Vercel (trusted automatically) or when not behind a proxy.
# TRUST_PROXY_HEADERS=true
